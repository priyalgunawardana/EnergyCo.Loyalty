@EnergyCo.Loyalty_HostAddress = http://localhost:5000
@CustomerId = 3fa85f64-5717-4562-b3fc-2c963f66afa6

# Product catalogue
# PRD01  Vortex 95     $1.20  Fuel
# PRD02  Vortex 98     $1.30  Fuel
# PRD03  Diesel        $1.10  Fuel
# PRD04  Twix 55g      $2.30  Shop
# PRD05  Mars 72g      $5.10  Shop
# PRD06  SNICKERS 72G  $3.40  Shop
# PRD07  Bounty 3 63g  $6.90  Shop
# PRD08  Snickers 50g  $4.00  Shop
#
# Active promotions
# PP001  2 pts/$  Any   01-Jan-2020 – 30-Jan-2020
# PP002  3 pts/$  Fuel  05-Feb-2020 – 15-Feb-2020
# PP003  4 pts/$  Shop  01-Mar-2020 – 20-Mar-2020
# DP001  20% off  PRD01+PRD02  01-Jan-2020 – 15-Feb-2020
# DP002  15% off  PRD04–PRD08  02-Mar-2020 – 20-Mar-2020

### List all products
GET {{EnergyCo.Loyalty_HostAddress}}/api/products
Accept: application/json

###

### Get basket for a customer
GET {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket
Accept: application/json

###

### Add Vortex 95 (PRD01) to basket – 10 units at $1.20
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/items
Content-Type: application/json

{
  "productId": "PRD01",
  "unitPrice": 1.20,
  "quantity": 10
}

###

### Add Vortex 98 (PRD02) to basket – 5 units at $1.30
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/items
Content-Type: application/json

{
