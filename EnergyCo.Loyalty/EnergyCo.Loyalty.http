### Checkout – invalid date format (400)
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "2020-04-03"
}

###

### Express checkout – no promotions (15-Dec-2019)
# Expects: discountApplied=0, pointsEarned=0
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout/express
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "15-Dec-2019",
  "items": [
    { "productId": "PRD01", "unitPrice": 1.20, "quantity": 10 },
    { "productId": "PRD04", "unitPrice": 2.30, "quantity": 3  }
  ]
}

###

### Express checkout – PP001 New Year Promo (10-Jan-2020, 2 pts/$ Any)
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout/express
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "10-Jan-2020",
  "items": [
    { "productId": "PRD01", "unitPrice": 1.20, "quantity": 10 },
    { "productId": "PRD02", "unitPrice": 1.30, "quantity": 5  },
    { "productId": "PRD04", "unitPrice": 2.30, "quantity": 3  }
  ]
}

###

### Express checkout – PP002 + DP001 Fuel overlap (10-Feb-2020)
# PP002: 3 pts/$ Fuel  |  DP001: 20% off PRD01+PRD02
# Expects: pointsEarned > 0 (Fuel), discountApplied > 0 (PRD01 only)
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout/express
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "10-Feb-2020",
  "items": [
    { "productId": "PRD01", "unitPrice": 1.20, "quantity": 20 },
    { "productId": "PRD03", "unitPrice": 1.10, "quantity": 8  },
    { "productId": "PRD05", "unitPrice": 5.10, "quantity": 2  }
  ]
}

###

### Express checkout – PP003 + DP002 Shop overlap (10-Mar-2020)
# PP003: 4 pts/$ Shop  |  DP002: 15% off PRD04–PRD08
# Expects: discountApplied > 0, pointsEarned > 0
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout/express
Content-Type: application/json

{
  "loyaltyCard": "CTX0000002",
  "transactionDate": "10-Mar-2020",
  "items": [
    { "productId": "PRD04", "unitPrice": 2.30, "quantity": 2 },
    { "productId": "PRD06", "unitPrice": 3.40, "quantity": 2 },
    { "productId": "PRD07", "unitPrice": 6.90, "quantity": 1 },
    { "productId": "PRD08", "unitPrice": 4.00, "quantity": 3 }
  ]
}

