### Add item – wrong price (400)
# PRD01 catalogue price is $1.20, not $9.99
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/items
Content-Type: application/json

{
  "productId": "PRD01",
  "unitPrice": 9.99,
  "quantity": 2
}

###

### Add item – unknown product (404)
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/items
Content-Type: application/json

{
  "productId": "PRD99",
  "unitPrice": 1.00,
  "quantity": 1
}

###

### Checkout – no promotions (15-Dec-2019)
# Expects: discountApplied=0, pointsEarned=0
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "15-Dec-2019"
}

###

### Checkout – PP001 New Year Promo (10-Jan-2020, 2 pts/$ Any)
# Expects: pointsEarned > 0, discountApplied = 0
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "10-Jan-2020"
}

###

### Checkout – PP002 Fuel Promo (10-Feb-2020, 3 pts/$ Fuel)
# Expects: pointsEarned > 0 (Fuel items only), discountApplied = 0
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "10-Feb-2020"
}

###

### Checkout – DP001 Fuel Discount (05-Jan-2020, 20% off PRD01+PRD02)
# Expects: discountApplied > 0, grandTotal < totalAmount
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "05-Jan-2020"
}

###

### Checkout – DP002 + PP003 overlap (10-Mar-2020)
# Both active: DP002 15% off Shop, PP003 4 pts/$ Shop
# Expects: discountApplied > 0, pointsEarned > 0
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/{{CustomerId}}/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000002",
  "transactionDate": "10-Mar-2020"
}

###

### Checkout – basket not found (404)
POST {{EnergyCo.Loyalty_HostAddress}}/api/customers/00000000-0000-0000-0000-000000000000/basket/checkout
Content-Type: application/json

{
  "loyaltyCard": "CTX0000001",
  "transactionDate": "03-Apr-2020"
}

