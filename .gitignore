## Ignore Visual Studio temporary files, build results, and other files generated by popular tools.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache / options directory
.vs/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
.nuget/

# Rider
.idea/

# OS-generated
.DS_Store
Thumbs.db

# Docker
.dockerignore
